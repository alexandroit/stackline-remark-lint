{
  "xo": false,
  "bugs": {
    "url": "https://github.com/alexandroit/stackline-remark-lint/issues"
  },
  "main": "index.js",
  "name": "@stackline/remark-lint",
  "type": "module",
  "types": "index.d.ts",
  "author": {
    "url": "https://wooorm.com",
    "name": "Titus Wormer",
    "email": "tituswormer@gmail.com"
  },
  "funding": {
    "url": "https://opencollective.com/unified",
    "type": "opencollective"
  },
  "license": "MIT",
  "scripts": {
    "test:upstream": "node --conditions development test.js",
    "test": "npm run test:upstream",
    "build": "node scripts/check-payload.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:types": "tsc --ignoreConfig --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --strict test/stackline-types.mts"
  },
  "homepage": "https://alexandro.net/docs/vanilla/remark-lint/",
  "keywords": [
    "stackline",
    "npm-package",
    "remark-lint",
    "markdown",
    "typescript",
    "unified",
    "remark",
    "remark-plugin",
    "plugin",
    "mdast",
    "lint",
    "validate",
    "maintenance-fork"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/stackline-remark-lint.git"
  },
  "description": "remark plugin to lint Markdown code style",
  "directories": {},
  "sideEffects": false,
  "contributors": [
    {
      "url": "https://wooorm.com",
      "name": "Titus Wormer",
      "email": "tituswormer@gmail.com"
    }
  ],
  "dependencies": {
    "unified": "^10.1.0",
    "@types/mdast": "^3.0.0",
    "remark-message-control": "^7.0.0"
  },
  "typeCoverage": {
    "detail": true,
    "strict": true,
    "atLeast": 100,
    "ignoreCatch": true
  },
  "version": "1.0.1",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "remark": "^14.0.0",
    "to-vfile": "^7.0.0",
    "remark-lint-no-heading-punctuation": "3.1.1",
    "remark-lint-no-multiple-toplevel-headings": "3.1.1",
    "remark-lint-no-undefined-references": "4.2.0",
    "remark-lint-final-newline": "2.1.1",
    "unified-lint-rule": "^2.0.0",
    "typescript": "7.0.2",
    "@types/node": "24.12.2"
  },
  "files": [
    "index.d.ts",
    "index.js",
    "readme.md",
    "UPSTREAM.md",
    "NOTICE",
    "CHANGELOG.md"
  ]
}
